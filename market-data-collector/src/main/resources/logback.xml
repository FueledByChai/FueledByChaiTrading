<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level %logger{30} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- The Parquet/Hadoop/WebSocket stacks are extremely chatty at DEBUG; keep WARN+. -->
  <logger name="org.apache.parquet" level="WARN"/>
  <logger name="org.apache.hadoop" level="WARN"/>
  <logger name="okhttp3" level="WARN"/>
  <logger name="org.java_websocket" level="WARN"/>
  <logger name="com.fueledbychai.paradex.common.api.ws" level="INFO"/>

  <root level="INFO">
    <appender-ref ref="STDOUT"/>
  </root>
</configuration>
